<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.7</version>
        <relativePath/>
    </parent>

    <groupId>com.rocommute</groupId>
    <artifactId>rain-commute-mcp</artifactId>
    <version>0.1.0</version>
    <name>rain-commute-mcp</name>
    <description>MCP server that checks for rain along your commute route</description>
    <url>https://github.com/rohithrag94-stack/rain-commute-mcp</url>
    <inceptionYear>2026</inceptionYear>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <url>https://github.com/rohithrag94-stack/rain-commute-mcp</url>
        <connection>scm:git:https://github.com/rohithrag94-stack/rain-commute-mcp.git</connection>
        <developerConnection>scm:git:https://github.com/rohithrag94-stack/rain-commute-mcp.git</developerConnection>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <java.version>25</java.version>
        <spring-ai.version>2.0.0</spring-ai.version>
        <jacoco.version>0.8.14</jacoco.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
            <exclusions>
                <!--
                    reactor-netty-http pulls in every platform's native transport (QUIC, epoll,
                    macOS DNS) and probes each at startup to pick the fastest available one, even
                    on platforms where it can never load. Each probe calls NativeLibraryUtil's
                    System::loadLibrary, which triggers a "restricted method" warning on Java 21+
                    (JEP 472) regardless of whether the load itself then succeeds or fails. This
                    server only makes a single occasional plain HTTPS GET to Open-Meteo, so the
                    native transports buy nothing; excluding all three leaves NIO as the sole
                    transport (no probing, no warning) on every platform.
                    (Excluding netty-codec-http3 itself instead of just its native-quic artifact
                    breaks reactor-netty-http, which references its Java classes unconditionally.)
                -->
                <exclusion>
                    <groupId>io.netty</groupId>
                    <artifactId>netty-codec-native-quic</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>io.netty</groupId>
                    <artifactId>netty-transport-native-epoll</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>io.netty</groupId>
                    <artifactId>netty-resolver-dns-native-macos</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <!--
                    Sets Enable-Native-Access on the base jar's manifest so spring-boot:repackage
                    carries it into the executable jar. reactor-netty-http's HTTP/3 availability
                    check (io.netty.handler.codec.quic.Quic) unconditionally probes for a native
                    QUIC/BoringSSL library via System::loadLibrary at first HTTP client use, even
                    with the native artifact excluded from the classpath (see webflux exclusions
                    above); Netty catches the failure and falls back cleanly, but the probe
                    itself trips the JEP 472 "restricted method" warning on Java 21+. This is the
                    fix the warning text itself points at (the command-line equivalent is the
                    "enable-native-access=ALL-UNNAMED" JVM flag), applied via manifest so it's
                    fixed regardless of how the jar is launched.
                -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <configuration>
                    <excludes>
                        <exclude>com/rocommute/mcp/RainCommuteMcpApplication.class</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>1.00</minimum>
                                        </limit>
                                        <limit>
                                            <counter>METHOD</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>1.00</minimum>
                                        </limit>
                                        <!--
                                            javac wraps pattern-matching switch cases in a synthetic
                                            MatchException catch/throw that JaCoCo counts as branches but
                                            that ordinary tests can never reach (jacoco/jacoco#1514,
                                            jacoco/jacoco#1219). All 4 currently-missed branches are this
                                            synthetic path; ceiling is pinned to that known baseline so any
                                            *new* real gap still fails the build.
                                        -->
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>MISSEDCOUNT</value>
                                            <maximum>4</maximum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
